#!/usr/bin/env bash

################################################################################
# S3 BUCKET OBJECTS DELETION SCRIPT
#
# Purpose:
#   This script deletes ALL objects in an S3 bucket.
#   Useful for emptying a bucket before deletion or cleanup operations.
#
# Prerequisites:
#   - AWS CLI installed and configured with valid AWS credentials
#   - Permissions: s3:ListBucket, s3:DeleteObject
#   - For versioned buckets: s3:DeleteObjectVersion
#
# Usage:
#   ./delete-objects <bucket-name>
#
# Example:
#   ./delete-objects my-data-bucket
#
# Important:
#   ⚠️  This PERMANENTLY deletes all objects
#   ⚠️  For versioned buckets, only latest versions are visible
#   ⚠️  Use '--version' flag for handling versioned objects
#
# How It Works:
#   1. Lists all objects in bucket using list-objects-v2
#   2. Extracts object keys using --query and text output
#   3. Pipes keys to xargs for batch deletion
#   4. Deletes each object using delete-object
################################################################################

echo " === Deleting All S3 Bucket Objects ==="

# Stop if any command fails.
set -e

# Make sure a bucket name was provided.
if [ -z "$1" ]; then
  echo "❌ ERROR: Bucket name is required"
  echo "Usage: ./delete-objects <bucket-name>"
  echo "Example: ./delete-objects my-data-bucket"
  exit 1
fi

# Store bucket name for readability
BUCKET_NAME="$1"

# Show the warning and start scanning the bucket.
echo "⚠️  WARNING: You are about to DELETE ALL OBJECTS in: $BUCKET_NAME"
echo "🔍 Scanning bucket..."

# Count objects before deletion.
OBJECT_COUNT=$(aws s3api list-objects-v2 \
  --bucket "$BUCKET_NAME" \
  --query 'length(Contents)' \
  --output text 2>/dev/null || echo "0")

echo "📊 Objects found: $OBJECT_COUNT"
echo ""

# STEP 5: Verify bucket exists and has objects
if [ "$OBJECT_COUNT" -eq 0 ]; then
  echo "✅ Bucket is already empty. No objects to delete."
  exit 0
fi

# STEP 6: Delete all objects
# list-objects-v2: Lists all objects in bucket (handles pagination automatically)
# --query 'Contents[].Key': Extracts only the object keys
# --output text: Outputs as space-separated values (not JSON)
# xargs: Takes input and passes as arguments to next command
# -I {}: Placeholder for each key
# delete-object: Deletes the object
echo "🗑️  Deleting objects..."

aws s3api list-objects-v2 --bucket "$BUCKET_NAME" \
  --query 'Contents[].Key' \
  --output text | \
  xargs -I {} aws s3api delete-object \
    --bucket "$BUCKET_NAME" \
    --key "{}"

# STEP 7: Verify deletion
echo ""
echo "✅ SUCCESS: All objects have been deleted from '$BUCKET_NAME'"
echo "💡 Bucket is now ready for deletion using './delete-bucket $BUCKET_NAME'"

exit 0